#lang racket/base

(require racket/list "../potkin/main.rkt")
(provide (struct-out reuse-fixture) make-tensor-reuse-fixture
         make-curried-reuse-fixture make-curried-family-reuse-fixture
         run-certified-reuse-examples nested-reuse-example)
(struct reuse-fixture (source frontier model replacements profile history) #:transparent)
(define (h left right) (singleton-hypersequent left (list right)))
(define (material id left right)
  (make-concrete-occurrence id '() (h left right) #:kind 'material))
(define (leaf K id) (validate-candidate K (raw-app id)))
(define (selected p formula)
  (add1 (index-of (mixed-boundary-left (derivation-root-boundary p)) formula equal?)))
(define (material-frontier p)
  (define K (checked-term-calculus p))
  (make-cut-witness p
    (filter (lambda (a) (and (pair? a)
                       (eq? (mixed-occurrence-family K (checked-node-occurrence (vertex-at-address p a))) 'material)))
            (vertex-addresses p))))
(define (first-forward p)
  (define-values (moves complete? reason) (enumerate-ck-schema-moves p #:policy 'forward))
  (unless (and complete? (pair? moves)) (error 'example "missing forward cell: ~e" reason))
  (car moves))

;; Increasing native tensor bundles; dimensions stay 1 to separate scaffold
;; growth from matrix growth. The optional dependency gives the T_j family.
(define (make-tensor-reuse-fixture [m 2] #:dependent-position [j #f])
  (unless (and (exact-integer? m) (>= m 2) (or (not j) (and (<= 1 j m) (integer? j))))
    (raise-argument-error 'make-tensor-reuse-fixture "m>=2, optional j in 1..m" (list m j)))
  (define atoms (for/list ([i (in-range 1 (add1 m))]) (string->symbol (format "a~a" i))))
  (define ids (for/list ([i (in-range 1 (add1 m))]) (string->symbol (format "p~a" i))))
  (define stock
    (append (for/list ([a (in-list atoms)] [id (in-list ids)] [i (in-naturals 1)])
              (material id (if (equal? i j) '(d) '()) a))
            (list (material 'r atoms 'c)) (if j (list (material 's '() 'd)) '())))
  (define K (make-mixed-schema-calculus stock))
  (define (pack ps)
    (if (null? (cdr ps)) (car ps) (mixed-apply K 'tensorR (list (car ps) (pack (cdr ps))))))
  (define producer (pack (map (lambda (id) (leaf K id)) ids)))
  (define consumer (leaf K 'r))
  (define suffix (last atoms))
  (for ([a (in-list (reverse (drop-right atoms 1)))])
    (set! consumer (mixed-apply K 'tensorL (list consumer)
                     #:indices (list (selected consumer a) (selected consumer suffix))))
    (set! suffix (list 'tensor a suffix)))
  (define bundle (mixed-apply K 'cut+ (list producer consumer) #:indices (list (selected consumer suffix))))
  (define source (if j (mixed-apply K 'cut+ (list (leaf K 's) bundle) #:indices '(1)) bundle))
  (define frontier (if j (make-cut-witness source '((2))) (material-frontier source)))
  (define assignments (for/hash ([o (in-list stock)]) (values (concrete-occurrence-id o) (make-qmatrix '((1))))))
  (define dimensions (for/hash ([a (in-list (append atoms '(c d)))]) (values a 1)))
  (define model (make-rational-model K dimensions assignments #:version '(tensor-demo 1)))
  (reuse-fixture source frontier model (map detached-entry-term (cut-witness-detached frontier))
                 (map concrete-occurrence-id stock) (if j '() (list (first-forward source)))))

;; All atoms have dimension 2. E's native canonical input order is (a g),
;; so compensation is E(M^-1 tensor id_g), not an unrecorded permutation.
(define (make-curried-reuse-fixture)
  (define K (make-mixed-schema-calculus
             (list (material 'e '(a g) 'b) (material 'd '(h) 'a) (material 'r '(b) 'c)
                   (material 'e-new '(a g) 'b) (material 'd-new '(h) 'a))))
  (define E (make-qmatrix '((1 2 3 4) (5 6 7 8))))
  (define I (qmatrix-identity 2))
  (define M (make-qmatrix '((2 0) (0 3))))
  (define inv (make-qmatrix '((1/2 0) (0 1/3))))
  (define E-new (qmatrix-multiply E (qmatrix-tensor inv I)))
  (define model (make-rational-model K (hash 'a 2 'b 2 'c 2 'g 2 'h 2)
                  (hash 'e E 'd I 'r I 'e-new E-new 'd-new M) #:version '(joint-dim2 1)))
  (define ar (mixed-apply K 'impliesR (list (leaf K 'e)) #:indices '(1)))
  (define al (mixed-apply K 'impliesL (list (leaf K 'd) (leaf K 'r)) #:indices '(1)))
  (define principal (add1 (index-of (mixed-occurrence-order K (checked-node-occurrence al)) 'principal)))
  (define source (mixed-apply K 'cut+ (list ar al) #:indices (list principal)))
  (define frontier (material-frontier source))
  (reuse-fixture source frontier model
                (list (leaf K 'e-new) (leaf K 'd-new) (detached-entry-term (last (cut-witness-detached frontier))))
                '(e d r) (list (first-forward source))))

;; The strict m-argument application family: E,D1,...,Dm,R remain physical
;; providers, while the constructive native history merges the whole scaffold.
;; Dimension 1 isolates scaffold/certificate growth from semantic matrix size.
(define (make-curried-family-reuse-fixture [m 1])
  (unless (exact-positive-integer? m)
    (raise-argument-error 'make-curried-family-reuse-fixture "positive argument count" m))
  (define atoms (for/list ([i (in-range 1 (add1 m))]) (string->symbol (format "a~a" i))))
  (define inputs (for/list ([i (in-range 1 (add1 m))]) (string->symbol (format "h~a" i))))
  (define ids (for/list ([i (in-range 1 (add1 m))]) (string->symbol (format "d~a" i))))
  (define stock
    (append (list (material 'e (append atoms '(g)) 'b))
            (for/list ([a (in-list atoms)] [input (in-list inputs)] [id (in-list ids)])
              (material id (list input) a))
            (list (material 'r '(b) 'c))))
  (define K (make-mixed-schema-calculus stock))
  (define producer (leaf K 'e))
  (for ([a (in-list (reverse atoms))])
    (set! producer (mixed-apply K 'impliesR (list producer) #:indices (list (selected producer a)))))
  (define consumer (leaf K 'r))
  (define suffix 'b)
  (for ([a (in-list (reverse atoms))] [id (in-list (reverse ids))])
    (set! consumer (mixed-apply K 'impliesL (list (leaf K id) consumer)
                       #:indices (list (selected consumer suffix))))
    (set! suffix (list 'implies a suffix)))
  (define source (mixed-apply K 'cut+ (list producer consumer) #:indices (list (selected consumer suffix))))
  (define frontier (material-frontier source))
  (define protection (certify-structured-ck-protection source))
  (unless (eq? 'SAFE (ck-protection-result-status protection))
    (error 'make-curried-family-reuse-fixture "strict application certificate unavailable: ~e" protection))
  (define certificate (ck-protection-evidence-certificate (ck-protection-result-evidence protection)))
  (define history (ck-structured-certificate-history certificate))
  (define model
    (make-rational-model K
      (for/hash ([a (in-list (append atoms inputs '(g b c)))]) (values a 1))
      (for/hash ([o (in-list stock)]) (values (concrete-occurrence-id o) (make-qmatrix '((1)))))
      #:version (list 'curried-family m)))
  (reuse-fixture source frontier model (map detached-entry-term (cut-witness-detached frontier))
                (map concrete-occurrence-id stock) history))

(define (prepare-fixture f #:policy [policy 'bidirectional] #:require [requested '(behavior boundary replay profile)])
  (prepare-reuse (reuse-fixture-source f) (reuse-fixture-frontier f) (reuse-fixture-model f)
    #:profile (reuse-fixture-profile f) #:history (reuse-fixture-history f)
    #:policy policy #:require requested))

;; Compose two native remainders. Direct physical holes are (1 1 1),(1 2),
;; (2 1), preserving the nested prefix and the ordered outer port shuffle.
(define (nested-reuse-example)
  (define K (make-mixed-schema-calculus
             (list (material 'x '() 'a) (material 'ia '(a) 'a)
                   (material 'q '() 'b) (material 'r '(a b) 'c))))
  (define inner (mixed-apply K 'cut+ (list (leaf K 'x) (leaf K 'ia)) #:indices '(1)))
  (define tr (mixed-apply K 'tensorR (list inner (leaf K 'q))))
  (define tl (mixed-apply K 'tensorL (list (leaf K 'r)) #:indices '(1 2)))
  (define source (mixed-apply K 'cut+ (list tr tl) #:indices '(1)))
  (define model (make-rational-model K (hash 'a 1 'b 1 'c 1)
                  (hash 'x (make-qmatrix '((2))) 'ia (make-qmatrix '((3)))
                        'q (make-qmatrix '((5))) 'r (make-qmatrix '((7))))))
  (define inner-frontier (make-cut-witness inner '((1))))
  (define outer-frontier (make-cut-witness source '((1 1) (1 2) (2 1))))
  (define inner-prep (prepare-reuse inner inner-frontier model #:profile '(x ia q r)))
  (define outer-prep (prepare-reuse source outer-frontier model #:profile '(x ia q r)
                      #:history (list (first-forward source))))
  (define inner-update (apply-reuse-update inner-prep (list (leaf K 'x))))
  (define outer-update (apply-reuse-update outer-prep (list (reuse-update-filled inner-update) (leaf K 'q) (leaf K 'r))))
  (define composed (context-insert (cut-witness-remainder outer-frontier) '(1 1)
                                   (cut-witness-remainder inner-frontier)))
  (define direct-frontier (make-cut-witness source (puncture-addresses composed)))
  (define direct-prep (prepare-reuse source direct-frontier model #:profile '(x ia q r)
                       #:history (list (first-forward source))))
  (define direct-update (apply-reuse-update direct-prep (list (leaf K 'x) (leaf K 'q) (leaf K 'r))))
  (define inner-eval (evaluate-rational-context (reuse-preparation-compiled inner-prep)
                                              (reuse-preparation-summaries inner-prep)))
  (define staged-eval (evaluate-rational-context (reuse-preparation-compiled outer-prep)
                        (cons (semantic-evaluation-matrix inner-eval)
                              (map semantic-summary-matrix (cdr (reuse-preparation-summaries outer-prep))))))
  (define direct-eval (evaluate-rational-context (reuse-preparation-compiled direct-prep)
                                                (reuse-preparation-summaries direct-prep)))
  (hash 'inner inner-update 'outer outer-update 'direct direct-update
        'hole-order (puncture-addresses composed)
        'staged=direct (equal? (semantic-evaluation-matrix staged-eval) (semantic-evaluation-matrix direct-eval))
        'replay=direct (equal? (reuse-update-replayed outer-update) (reuse-update-replayed direct-update))
        'verification (verify-reuse-update direct-prep direct-update)))

(define (run-certified-reuse-examples)
  (define tensor (make-tensor-reuse-fixture))
  (define tp (prepare-fixture tensor))
  (define shape (apply-reuse-update tp (reuse-fixture-replacements tensor)))
  (define f (make-curried-reuse-fixture))
  (define p (prepare-fixture f #:require '(behavior boundary replay)))
  (define joint (apply-reuse-update p (reuse-fixture-replacements f)))
  (define rejected-profile
    (apply-reuse-update (prepare-fixture f #:require '(behavior boundary replay profile fidelity))
                        (reuse-fixture-replacements f)))
  (define enlarged (apply-reuse-update (prepare-fixture f) (reuse-fixture-replacements f)
                     #:profile '(e d r e-new d-new)))
  (define old (reuse-preparation-providers p))
  (define bad (apply-reuse-update p (list (first old) (second (reuse-fixture-replacements f)) (third old))))
  (define contextual (make-tensor-reuse-fixture 2 #:dependent-position 2))
  (define forward (apply-reuse-update (prepare-fixture contextual #:policy 'forward)
                                      (reuse-fixture-replacements contextual)))
  (define inverse (apply-reuse-update (prepare-fixture contextual)
                                      (reuse-fixture-replacements contextual)))
  (hash 'shape-changing shape 'joint joint 'uncompensated bad 'old-profile rejected-profile
        'enlarged-profile enlarged 'forward forward 'bidirectional inverse 'nested (nested-reuse-example)))

(module+ main
  (for ([(name value) (in-hash (run-certified-reuse-examples))])
    (if (reuse-update? value)
        (printf "~a: accepted=~a contracts=~s retained=~s admitted=~a compiled=~a replay-events=~a independently-verified=~a\n"
          name (reuse-update-accepted? value)
          (for/hash ([(key c) (in-hash (reuse-update-contracts value))]) (values key (reuse-contract-status c)))
          (hash-ref (reuse-update-plan value) 'cached-summaries)
          (hash-ref (reuse-update-plan value) 'provider-admissions)
          (hash-ref (reuse-update-plan value) 'context-compilations)
          (hash-ref (reuse-update-plan value) 'replayed-events)
          (reuse-verification-valid? (verify-reuse-update (reuse-update-preparation value) value)))
        (printf "~a: staged=direct ~a, replay=direct ~a, physical holes ~s\n"
                name (hash-ref value 'staged=direct) (hash-ref value 'replay=direct) (hash-ref value 'hole-order)))))

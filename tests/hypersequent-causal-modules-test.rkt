#lang racket/base

(require rackunit racket/list racket/match "../potkin/main.rkt")

;; Test-local occurrence specifications, never a second proof carrier. Each
;; component/formula label resolves to a native local occurrence position.
(define (token id formula) (cons id formula))
(define (component id left right) (list id left right))
(define (boundary entries)
  (make-hypersequent
   (for/list ([c (in-list entries)])
     (make-sequent (map cdr (second c)) (map cdr (third c))))))
(define (component-index entries id)
  (define pending entries)
  (for/first ([seq (in-list (hypersequent-sequents (boundary entries)))] [i (in-naturals 1)]
              #:do [(define c (findf (lambda (c) (equal? seq (make-sequent (map cdr (second c)) (map cdr (third c))))) pending))
                    (set! pending (remove c pending eq?))]
              #:when (eq? (first c) id)) i))
(define (position entries id)
  (for*/first ([c (in-list entries)] [side (in-list '(left right))]
               #:do [(define ts (if (eq? side 'left) (second c) (third c)))
                     (define t (assq id ts))]
               #:when t)
    (formula-occurrence-position
     (component-index entries (first c)) side (cdr t)
     (add1 (count (lambda (p) (equal? (cdr p) (cdr t))) (take ts (index-of ts t eq?)))))))
(define all '())
(define equipment-makers '())
(define (rule id premises output component-routes formula-routes family [copy-info #f])
  (define ps (map boundary premises))
  (define out (boundary output))
  (define incidence
    (make-component-incidence ps out
     (for/list ([r (in-list component-routes)])
       (make-component-edge (first r)
                            (component-index (list-ref premises (sub1 (first r))) (second r))
                            (component-index output (third r))))))
  (define occurrence
    (make-concrete-occurrence id ps out #:kind (if (null? premises) 'material 'structural)
                              #:instance (list 'exact-avron-instance family id)
                              #:incidence incidence))
  (set! all (cons occurrence all))
  (when family
    (set! equipment-makers
          (cons
           (lambda (K)
             (define edges
               (for/list ([r (in-list formula-routes)])
                 (make-equipped-formula-edge occurrence (first r)
                  (position (list-ref premises (sub1 (first r))) (second r))
                  (position output (third r)))))
             (if (eq? family 'Com)
                 (match-let ([(list G copies active-outs) copy-info])
                   (define ref (and (pair? G) (boundary G)))
                   (define order
                     (sort (range (length G)) <
                           #:key (lambda (i) (component-index G (first (list-ref G i))))))
                   (define ordered-G (map (lambda (i) (list-ref G i)) order))
                   (define ordered-copies
                     (map (lambda (is) (map (lambda (i) (list-ref is i)) order)) copies))
                   (define entries (append premises (list output)))
                   (define cis
                     (for/list ([es (in-list entries)] [ids (in-list ordered-copies)])
                       (map (lambda (id) (component-index es id)) ids)))
                   (define cfs
                     (for/list ([es (in-list entries)] [ids (in-list ordered-copies)])
                       (append-map
                        (lambda (gc id)
                          (define pc (findf (lambda (c) (eq? id (first c))) es))
                          (map (lambda (gt pt) (cons (position G (car gt)) (position es (car pt))))
                               (append (second gc) (third gc)) (append (second pc) (third pc)))) ordered-G ids)))
                   (equip-avron-communication K occurrence ref cis cfs
                                             (map (lambda (id) (component-index output id)) active-outs) edges))
                 (equip-avron-structural
                  K occurrence family edges
                  #:component-copies
                  (and copy-info
                       (list (component-index (first premises) (first copy-info))
                             (component-index (first premises) (second copy-info))
                             (component-index output (third copy-info))))))) equipment-makers)))
  occurrence)
(define (ids entries)
  (append-map (lambda (c) (map car (append (second c) (third c)))) entries))
(define (unary id family input output cm fm [copy #f])
  (rule id (list input) output (map (lambda (p) (list 1 (car p) (cdr p))) cm)
        (map (lambda (p) (list 1 (car p) (cdr p))) fm) family copy))
(define (identity-formulas entries) (map (lambda (id) (cons id id)) (ids entries)))
(define (identity-components entries) (map (lambda (c) (cons (first c) (first c))) entries))
(define (com id G left right first-active second-active out-a out-b)
  (define input1 (append G (list left)))
  (define input2 (append G (list right)))
  (define output (append G (list out-a out-b)))
  (define passive-cm
    (for*/list ([slot '(1 2)] [c (in-list G)]) (list slot (first c) (first c))))
  (define active-cm
    (for*/list ([entry (in-list (list (cons 1 first-active) (cons 2 second-active)))]
                [c (in-list (list out-a out-b))]) (list (car entry) (cdr entry) (first c))))
  (define fm
    (append
     (for*/list ([slot '(1 2)] [id (in-list (ids G))]) (list slot id id))
     (for/list ([id (in-list (ids (list left)))]) (list 1 id id))
     (for/list ([id (in-list (ids (list right)))]) (list 2 id id))))
  (rule id (list input1 input2) output (append passive-cm active-cm) fm 'Com
        (list G (make-list 3 (map first G)) (list (first out-a) (first out-b)))))

;; Repeated passive G has two equal formula occurrences. EC's two component
;; copies have separately named tokens, and their isomorphisms are supplied.
(define p (component 'p (list (token 'pa 'P) (token 'pb 'P)) (list (token 'pr 'p-result))))
(define p1 (component 'p1 (list (token 'p1a 'P) (token 'p1b 'P)) (list (token 'p1r 'p-result))))
(define p2 (component 'p2 (list (token 'p2a 'P) (token 'p2b 'P)) (list (token 'p2r 'p-result))))
(define pw (component 'p (append (second p) (list (token 'pw 'W))) (third p)))
(define L (component 'L (list (token 'l1 'A) (token 'l2 'A)) (list (token 'lr 'R))))
(define R (component 'R (list (token 'r1 'A) (token 'r2 'A)) (list (token 'rr 'S))))
(define O1 (component 'O1 (list (token 'l1 'A) (token 'r1 'A)) (third L)))
(define O2 (component 'O2 (list (token 'l2 'A) (token 'r2 'A)) (third R)))
(define O1w (component 'O1 (append (second O1) (list (token 'aw 'V))) (third O1)))
(define Zactive (component 'Z (list (token 'z1 'A) (token 'z2 'A)) (list (token 'zr 'T))))
(define F1 (component 'F1 (append (second O1) (list (token 'z1 'A))) (third O1)))
(define F1w (component 'F1 (append (second F1) (list (token 'aw 'V))) (third F1)))
(define F2 (component 'F2 (list (token 'z2 'A)) (third Zactive)))
(define XL (list p1 p2 L))
(define YR (list p1 p2 R))
(define CL (list p L))
(define CR (list p R))
(define WL (list pw L))
(define WR (list pw R))
(define inner-W (list pw O1 O2))
(define inner-base (list p O1 O2))
(define inner-expanded (list p1 p2 O1 O2))
(define outer-in (list pw O2 O1))
(define outer-in-W (list pw O2 O1w))
(define outer-Z (list pw O2 Zactive))
(define final (list pw O2 F1w F2))
(define final-base (list pw O2 F1 F2))
(define ec-fm (append (map cons '(p1a p1b p1r) '(pa pb pr))
                      (map cons '(p2a p2b p2r) '(pa pb pr))))
(define ec-left (unary 'cm-ec-left 'EC XL CL '((p1 . p) (p2 . p) (L . L))
                       (append ec-fm (identity-formulas (list L))) '(p1 p2 p)))
(define ec-right (unary 'cm-ec-right 'EC YR CR '((p1 . p) (p2 . p) (R . R))
                        (append ec-fm (identity-formulas (list R))) '(p1 p2 p)))
(define piw-left (unary 'cm-piw-left 'IW CL WL (identity-components CL) (identity-formulas CL)))
(define piw-right (unary 'cm-piw-right 'IW CR WR (identity-components CR) (identity-formulas CR)))
(define com-W (com 'cm-inner-W (list pw) L R 'L 'R O1 O2))
(define com-base (com 'cm-inner-base (list p) L R 'L 'R O1 O2))
(define com-expanded (com 'cm-inner-expanded (list p1 p2) L R 'L 'R O1 O2))
(define bad-com-expanded
  (rule 'cm-inner-expanded-wrong-copy (list XL YR) inner-expanded
        '((1 p1 p1) (1 p2 p2) (2 p1 p2) (2 p2 p1)
          (1 L O1) (1 L O2) (2 R O1) (2 R O2))
        (append (map (lambda (id) (list 1 id id)) (ids XL))
                (map (lambda (a b) (list 2 a b)) '(p1a p1b p1r p2a p2b p2r)
                     '(p2a p2b p2r p1a p1b p1r))
                (map (lambda (id) (list 2 id id)) (ids (list R))))
        'Com (list (list p1 p2) '((p1 p2) (p2 p1) (p1 p2)) '(O1 O2))))
(define piw-output (unary 'cm-piw-output 'IW inner-base inner-W (identity-components inner-base) (identity-formulas inner-base)))
(define ec-output (unary 'cm-ec-output 'EC inner-expanded inner-base
                        '((p1 . p) (p2 . p) (O1 . O1) (O2 . O2))
                        (append ec-fm (identity-formulas (list O1 O2))) '(p1 p2 p)))
(define aiw-input (unary 'cm-aiw-input 'IW outer-in outer-in-W
                        (identity-components outer-in) (identity-formulas outer-in)))
(define outer-W (com 'cm-outer-W (list pw O2) O1w Zactive 'O1 'Z F1w F2))
(define outer-base (com 'cm-outer-base (list pw O2) O1 Zactive 'O1 'Z F1 F2))
(define aiw-output (unary 'cm-aiw-output 'IW final-base final
                         (identity-components final-base) (identity-formulas final-base)))
(define X-occ (rule 'cm-X '() XL '() '() #f))
(define Y-occ (rule 'cm-Y '() YR '() '() #f))
(define Z-occ (rule 'cm-Z '() outer-Z '() '() #f))
(define X-prime-occ (rule 'cm-X-prime '() XL '() '() #f))
(define wrap-occ (rule 'cm-provider-wrapper (list XL) XL
                       (map (lambda (c) (list 1 (first c) (first c))) XL)
                       (map (lambda (id) (list 1 id id)) (ids XL)) #f))

;; Additional active IW/IC and synchronized passive IC/EW cells use the SAME
;; immutable registry, including both input sides and both output routes.
(define extra-cells '())
(for* ([side '(1 2)] [destination '(1 2)])
  (define id (string->symbol (format "cm-active-~a-~a" side destination)))
  (define before (if (= side 1) L R))
  (define w-id (string->symbol (format "w-~a-~a" side destination)))
  (define w (token w-id 'A))
  (define changed (component (first before) (append (second before) (list w)) (third before)))
  (define oa (if (= destination 1) (component 'O1 (append (second O1) (list w)) (third O1)) O1))
  (define ob (if (= destination 2) (component 'O2 (append (second O2) (list w)) (third O2)) O2))
  (define si (unary (string->symbol (format "~a-input" id)) 'IW (list before) (list changed)
                    (identity-components (list before)) (identity-formulas (list before))))
  (define so (unary (string->symbol (format "~a-output" id)) 'IW (list O1 O2) (list oa ob)
                    (identity-components (list O1 O2)) (identity-formulas (list O1 O2))))
  (define sc (com (string->symbol (format "~a-com-source" id)) '()
                  (if (= side 1) changed L) (if (= side 2) changed R) 'L 'R oa ob))
  (define tc (com (string->symbol (format "~a-com-target" id)) '() L R 'L 'R O1 O2))
  (set! extra-cells (cons (list id (if (= side 1) (list si #f) (list #f si)) so sc tc) extra-cells)))

;; Active contraction fixes r0: l1 survives and l2 maps to l1. Compatible
;; expanded Com routes both to O1; the independently requested split is kept
;; as a checked Com occurrence, but cannot instantiate this IC square.
(define Lc (component 'L (list (token 'l1 'A)) (third L)))
(define O1c (component 'O1 (list (token 'l1 'A) (token 'r1 'A)) (third O1)))
(define O2c (component 'O2 (list (token 'r2 'A)) (third O2)))
(define O1expanded (component 'O1 (list (token 'l1 'A) (token 'l2 'A) (token 'r1 'A)) (third O1)))
(define ic-in (unary 'cm-active-ic-input 'IC (list L) (list Lc) '((L . L))
                     '((l1 . l1) (l2 . l1) (lr . lr))))
(define ic-out (unary 'cm-active-ic-output 'IC (list O1expanded O2c) (list O1c O2c)
                      '((O1 . O1) (O2 . O2))
                      '((l1 . l1) (l2 . l1) (r1 . r1) (r2 . r2) (lr . lr) (rr . rr))))
(define ic-com-source (com 'cm-active-ic-source '() Lc R 'L 'R O1c O2c))
(define ic-com-target (com 'cm-active-ic-target '() L R 'L 'R O1expanded O2c))
(define ic-com-split (com 'cm-active-ic-split '() L R 'L 'R O1 O2))
(set! extra-cells (cons (list 'cm-active-IC (list ic-in #f) ic-out ic-com-source ic-com-target) extra-cells))

(define pc (component 'p (list (token 'pa 'P)) (third p)))
(define pic-left (unary 'cm-pic-left 'IC CL (list pc L) (identity-components CL)
                        (append '((pa . pa) (pb . pa) (pr . pr)) (identity-formulas (list L)))))
(define pic-right (unary 'cm-pic-right 'IC CR (list pc R) (identity-components CR)
                         (append '((pa . pa) (pb . pa) (pr . pr)) (identity-formulas (list R)))))
(define pic-out (unary 'cm-pic-output 'IC inner-base (list pc O1 O2) (identity-components inner-base)
                       (append '((pa . pa) (pb . pa) (pr . pr)) (identity-formulas (list O1 O2)))))
(define pic-com (com 'cm-pic-source (list pc) L R 'L 'R O1 O2))
(set! extra-cells (cons (list 'cm-passive-IC (list pic-left pic-right) pic-out pic-com com-base) extra-cells))
(define ew-left (unary 'cm-ew-left 'EW (list L) CL '((L . L)) (identity-formulas (list L))))
(define ew-right (unary 'cm-ew-right 'EW (list R) CR '((R . R)) (identity-formulas (list R))))
(define ew-out (unary 'cm-ew-output 'EW (list O1 O2) inner-base '((O1 . O1) (O2 . O2)) (identity-formulas (list O1 O2))))
(define ew-com (com 'cm-ew-target '() L R 'L 'R O1 O2))
(set! extra-cells (cons (list 'cm-passive-EW (list ew-left ew-right) ew-out com-base ew-com) extra-cells))

;; An actual atomic identity/Cut erasing cell exercises the explicit stronger
;; sector failure while preserving the older general cospan certificate.
(define I (list (component 'I (list (token 'ia 'A)) (list (token 'ir 'A)))))
(define identity-occ (rule 'cm-atomic-id '() I '() '() #f))
(define cut-occ (rule 'cm-atomic-cut (list I I) I '((1 I I) (2 I I)) '() #f))
(define Zwrap-occ (rule 'cm-Z-wrapper (list outer-Z) outer-Z
                        (map (lambda (c) (list 1 (first c) (first c))) outer-Z)
                        (map (lambda (id) (list 1 id id)) (ids outer-Z)) #f))
(define admin-after-occ
  (make-concrete-occurrence 'cm-provider-wrapper-admin
                           (vector->list (concrete-occurrence-premises wrap-occ))
                           (concrete-occurrence-conclusion wrap-occ)
                           #:kind (concrete-occurrence-kind wrap-occ)
                           #:tag (concrete-occurrence-tag wrap-occ)
                           #:instance (concrete-occurrence-instance wrap-occ)
                           #:incidence (concrete-occurrence-incidence wrap-occ)))
(set! all (cons admin-after-occ all))
(define K (make-equipped-calculus all))
(define equipment (map (lambda (maker) (maker K)) (reverse equipment-makers)))
(define unary-occ (filter (lambda (o) (= (occurrence-arity o) 1))
                          (map avron-rule-equipment-occurrence equipment)))
(define binary-occ (filter (lambda (o) (= (occurrence-arity o) 2))
                           (map avron-rule-equipment-occurrence equipment)))
(define signature (make-structural-normalization-signature K unary-occ binary-occ equipment))
(define B (make-material-profile K all))
(define (app occurrence . children)
  (define result (assemble-checked-application K occurrence children))
  (unless (checked-node? result) (error 'fixture "native assembly failed: ~e" result))
  result)
(define (hole occurrence slot) (identity-context K (occurrence-premise occurrence slot)))
(define (float-cell id inputs out sc tc)
  (define lh-children
    (for/list ([step (in-list inputs)] [slot (in-naturals 1)])
      (if step (app step (hole step 1)) (hole sc slot))))
  (define lhs (apply app sc lh-children))
  (define rhs (app out (app tc (hole tc 1) (hole tc 2))))
  (register-structural-float-cell id signature lhs rhs '(X Y) '(X Y)
                                (identity-boundary-routing (derivation-root-boundary lhs))))
(define passive-IW (float-cell 'cm-passive-IW (list piw-left piw-right) piw-output com-W com-base))
(define passive-EC (float-cell 'cm-passive-EC (list ec-left ec-right) ec-output com-base com-expanded))
(define active-IW (float-cell 'cm-outer-active-IW (list aiw-input #f) aiw-output outer-W outer-base))
(define extra (for/list ([data (in-list extra-cells)]) (apply float-cell data)))
(check-equal? (length extra) 7)
(define registry (make-normalization-cell-registry signature (append (list passive-IW passive-EC active-IW) extra)))
(define X (app X-occ))
(define Y (app Y-occ))
(define Z (app Z-occ))
(check-false (eq? X Y))
(define source (app outer-W (app aiw-input
                               (app com-W (app piw-left (app ec-left X))
                                    (app piw-right (app ec-right Y)))) Z))
(define requests
  (list (make-normalization-event-request registry 'stage-IW 'cm-passive-IW '(1 1))
        (make-normalization-event-request registry 'stage-EC 'cm-passive-EC '(1 1 1))
        (make-normalization-event-request registry 'stage-active 'cm-outer-active-IW '())))
(define frontier (make-cut-witness source '((1 1 1 1 1) (1 1 2 1 1) (2))))
(define (history proof witness reqs [profile B])
  (define h (compile-normalization-replay proof witness registry reqs #:material-profile profile #:polynomial-term-cap 64))
  (unless (normalization-replay-certificate? h) (error 'fixture "history failed: ~e" h)) h)
(define h1 (history source frontier (take requests 1)))
(define s1 (normalization-replay-certificate-target h1))
(define h2 (history s1 (make-cut-witness s1 (normalization-replay-certificate-survivor-target-addresses h1)) (list (second requests))))
(define s2 (normalization-replay-certificate-target h2))
(define h3 (history s2 (make-cut-witness s2 (normalization-replay-certificate-survivor-target-addresses h2)) (list (third requests))))
(define direct (history source frontier requests))
(define target (normalization-replay-certificate-target direct))
(define modules (certify-causal-modules direct))
(check-true (causal-module-certificate? modules))
(check-true (check-causal-module-certificate modules))
(check-equal? (map fourth (causal-module-certificate-budget-steps modules)) '(3 3 1))
(check-equal? (- (proof-structural-budget source signature) (proof-structural-budget target signature)) 7)
(check-equal? (length (causal-module-certificate-source-blocks modules)) 5)
(check-equal? (length (causal-module-certificate-edges modules)) 4)
(define c1 (certify-causal-modules h1))
(define c2 (certify-causal-modules h2))
(define c3 (certify-causal-modules h3))
(define staged (compose-causal-module-certificates (compose-causal-module-certificates c1 c2) c3))
(define right-staged (compose-causal-module-certificates c1 (compose-causal-module-certificates c2 c3)))
(for ([c (in-list (list staged right-staged))])
  (check-true (causal-module-certificate? c))
  (check-equal? (causal-module-certificate-source-blocks c) (causal-module-certificate-source-blocks modules))
  (check-equal? (causal-module-certificate-target-blocks c) (causal-module-certificate-target-blocks modules))
  (check-equal? (causal-module-certificate-edges c) (causal-module-certificate-edges modules))
  (check-equal? (normalization-causal-interface-live-origins (causal-module-certificate-interface c))
                (normalization-causal-interface-live-origins (causal-module-certificate-interface modules))))
(check-true (> (length (causal-module-certificate-source-blocks c1))
               (length (causal-module-certificate-source-blocks staged))))

;; Production queries use a class-edge antichain and retain both native
;; tuples, remainders and reconstructions. The inner module is transformed;
;; guardedness therefore does not mean that this detached factor is opaque.
(define certificate (transport-causal-module-cut modules '((1 1) (2))))
(check-equal? (causal-module-cut-transport-kind certificate) 'proper)
(check-equal? (cut-witness-addresses (causal-module-cut-transport-target-witness certificate)) '((1 1) (1 2)))
(check-false (causal-module-cut-transport-opaque? certificate))
(define inverse (transport-causal-module-cut modules '((1 1) (1 2)) #:direction 'target->source))
(check-equal? (cut-witness-addresses (causal-module-cut-transport-target-witness inverse)) '((1 1) (2)))
(for ([c (in-list (list certificate inverse))])
  (for ([w (in-list (list (causal-module-cut-transport-source-witness c) (causal-module-cut-transport-target-witness c)))])
    (check-true (cut-witness-reconstructs? w))
    (check-equal? (map detached-entry-address (cut-witness-detached w)) (cut-witness-addresses w))
    (check-equal? (puncture-addresses (cut-witness-remainder w)) (cut-witness-addresses w))))
(check-equal? (causal-module-cut-transport-source-refill certificate) source)
(check-equal? (causal-module-cut-transport-target-refill certificate) target)
(check-equal? (causal-module-cut-transport-kind (transport-causal-module-cut modules '())) 'empty)
(define whole (transport-causal-module-cut modules '() #:whole? #t))
(check-equal? (causal-module-cut-transport-kind whole) 'whole)
(check-false (causal-module-cut-transport-source-witness whole))
(check-equal? (proof-forest-factors (causal-module-cut-transport-source-whole-forest whole)) (list source))
(check-equal? (proof-forest-factors (causal-module-cut-transport-target-whole-forest whole)) (list target))
(check-not-equal? (causal-module-cut-transport-source-whole-forest whole)
                  (causal-module-cut-transport-target-whole-forest whole))
(check-equal? (cut-error-code (transport-causal-module-cut modules '(()))) 'root-cut)
(define crossing (transport-causal-module-cut modules '((1 1 1))))
(check-equal? (causal-module-cut-transport-kind crossing) 'crossing)
(check-true (causal-module-block-read? (car (causal-module-cut-transport-crossing-blocks crossing))))

;; One-time admission reads the replacement. Replay then uses native checker
;; assembly, retains Q' and the other provider objects, and reads no interiors.
(define Q-prime (app wrap-occ (app X-prime-occ)))
(define replayed (replay-compiled-normalization (normalization-replay-certificate-compiled-history direct)
                                               (list Q-prime Y Z)))
(check-true (normalization-replay-result? replayed))
(check-true (normalization-replay-result-valid? replayed))
(check-equal? (normalization-replay-result-opaque-interior-inspections replayed) 0)
(check-true (> (normalization-replay-result-admission-inspections replayed) 0))
(for ([provider (in-list (list Q-prime Y Z))] [address (in-list '((1 1 1 1 1) (1 1 1 1 2) (1 2)))])
  (check-eq? (vertex-at-address (normalization-replay-result-target replayed) address) provider))

;; Small independent oracle. This is the ONLY native cut enumeration here.
;; Return inconclusive at the cap; never present a truncated count as exact.
(define generated 0)
(define generated-witnesses 0)
(define generated-raw-choices 0)
(define (independently-saturated? quotient addresses)
  (define groups
    (for/fold ([r (hash)]) ([(a rep) (in-hash quotient)])
      (define owner (or (findf (lambda (root) (address-prefix? root a)) addresses) 'remainder))
      (hash-update r rep (lambda (owners) (cons owner owners)) '())))
  (for/and ([owners (in-hash-values groups)]) (= (length (remove-duplicates owners equal?)) 1)))
(define (oracle proof certificate direction cap #:selector [selector #f])
  (let/ec stop
    (define interface (causal-module-certificate-interface certificate))
    (define quotient (if (eq? direction 'source->target)
                         (normalization-causal-interface-source-quotient interface)
                         (normalization-causal-interface-live-origins interface)))
    (for/fold ([p (if (or (not selector)
                          (material-hopf-selector-forest-pure? selector (make-proof-forest K (list proof))))
                      (hash 1 1) (hash))]
               [protected '()] #:result (list p (reverse protected)))
              ([witness (in-admissible-cut-witnesses proof)] [n (in-naturals 1)])
      (set! generated (add1 generated))
      (set! generated-witnesses (add1 generated-witnesses))
      (when (> n cap) (stop 'inconclusive))
      (define addresses (cut-witness-addresses witness))
      (check-true (cut-witness-reconstructs? witness))
      (define saturated? (independently-saturated? quotient addresses))
      (define c (transport-causal-module-cut certificate addresses #:direction direction))
      (check-equal? (not (eq? (causal-module-cut-transport-kind c) 'crossing)) saturated?)
      (if (or (not saturated?)
              (and selector (not (material-hopf-selector-forest-pure? selector (cut-witness-forest witness)))))
          (values p protected)
          (values (hash-update p (length addresses) add1 0) (cons c protected))))))
(define source-oracle (oracle source modules 'source->target 256))
(define target-oracle (oracle target modules 'target->source 256))
(check-equal? (first source-oracle) (first target-oracle))
(check-equal? (causal-module-polynomial modules) (first source-oracle))
(check-equal? (causal-module-polynomial modules #:material? #t) (first source-oracle))
(check-equal? (oracle source modules 'source->target 1) 'inconclusive)
(define selective-B (make-material-profile K (remove Y-occ all eq?)))
(define selective-history (history source frontier requests selective-B))
(define selective-modules (certify-causal-modules selective-history))
(define selective-selector (prepare-material-hopf-selector selective-B))
(check-true (causal-module-base-report-compatible? (check-causal-module-base-profile selective-modules)))
(check-equal? (causal-module-polynomial selective-modules #:material? #t)
              (first (oracle source selective-modules 'source->target 256 #:selector selective-selector)))
(check-equal? (causal-module-polynomial selective-modules #:material? #t)
              (first (oracle (normalization-replay-certificate-target selective-history) selective-modules
                             'target->source 256 #:selector selective-selector)))
(for ([c (in-list (second source-oracle))])
  (define a (cut-witness-addresses (causal-module-cut-transport-target-witness c)))
  (define back (transport-causal-module-cut modules a #:direction 'target->source))
  (check-equal? (cut-witness-addresses (causal-module-cut-transport-target-witness back))
                (cut-witness-addresses (causal-module-cut-transport-source-witness c)))
  (define via-stages (transport-causal-module-cut staged (cut-witness-addresses (causal-module-cut-transport-source-witness c))))
  (check-equal? (causal-module-cut-transport-target-witness via-stages) (causal-module-cut-transport-target-witness c))
  (check-equal? (append* (causal-module-cut-transport-projected-events via-stages))
                (append* (causal-module-cut-transport-projected-events c))))

;; A bounded degree-three flag family: three nested class-descendant regions
;; (X inside the inner module inside the whole) restrict consistently. Both
;; parenthesizations retain the same addressed seams and native refills.
(define flags '(((1 1 1 1 1) (1 1)) ((1 1 2 1 1) (1 1)) ((2) ())))
(for ([flag (in-list flags)])
  (define inner (transport-causal-module-cut modules (list (first flag))))
  (define outer (if (null? (second flag)) whole (transport-causal-module-cut modules (list (second flag)))))
  (check-true (cut-witness-reconstructs? (causal-module-cut-transport-target-witness inner)))
  (when (eq? (causal-module-cut-transport-kind outer) 'proper)
    (define ia (car (cut-witness-addresses (causal-module-cut-transport-target-witness inner))))
    (define oa (car (cut-witness-addresses (causal-module-cut-transport-target-witness outer))))
    (define factor (detached-entry-term (car (causal-module-cut-transport-target-detached outer))))
    (define nested (make-cut-witness factor (list (drop ia (length oa)))))
    (check-true (cut-witness-reconstructs? nested))
    ;; Cut the inner region first, then cut the outer region in its punctured
    ;; remainder. Compare ALL THREE native coordinates with outer-first.
    (define inner-first
      (make-cut-witness (causal-module-cut-transport-target-remainder inner) (list oa)))
    (check-true (cut-witness-reconstructs? inner-first))
    (check-equal? (detached-entry-term (car (cut-witness-detached inner-first)))
                  (cut-witness-remainder nested))
    (check-equal? (cut-witness-remainder inner-first)
                  (causal-module-cut-transport-target-remainder outer))
    (check-equal? (detached-entry-term (car (cut-witness-detached nested)))
                  (detached-entry-term (car (causal-module-cut-transport-target-detached inner))))))

;; Raw versus protected scalar specification, including nonnullary Y. z^2 is
;; only the ground specialization. These are independent polynomial operations
;; checked against native raw choices; no tensor equality is inferred.
(define (pmul a b)
  (for*/fold ([r (hash)]) ([(i x) (in-hash a)] [(j y) (in-hash b)])
    (hash-update r (+ i j) (lambda (old) (+ old (* x y))) 0)))
(define (padd a b)
  (for/fold ([r a]) ([(i c) (in-hash b)]) (hash-update r i (lambda (old) (+ old c)) 0)))
(define (psub a b)
  (for/fold ([r a]) ([(i c) (in-hash b)])
    (define n (- (hash-ref r i 0) c)) (if (zero? n) (hash-remove r i) (hash-set r i n))))
(define z (hash 1 1))
(define (raw-A proof)
  (for/fold ([p z]) ([addresses (in-admissible-cuts proof)])
    (set! generated (add1 generated))
    (set! generated-raw-choices (add1 generated-raw-choices))
    (hash-update p (length addresses) add1 0)))
(define Xlocal (vertex-at-address source '(1 1)))
(define Ylocal (app Zwrap-occ Z))
(define AY (raw-A Ylocal))
(define AX (raw-A Xlocal))
(define local-source (app outer-W (app aiw-input Xlocal) Ylocal))
(define local-target (app aiw-output (app outer-base Xlocal Ylocal)))
(check-equal? (raw-A local-source) (padd z (pmul (padd z AX) AY)))
(check-equal? (raw-A local-target) (padd z (padd z (pmul AX AY))))
(check-equal? (psub (raw-A local-source) (raw-A local-target)) (pmul z (psub AY (hash 0 1))))
(define local-history (history local-source (make-cut-witness local-source '((1 1) (2))) (list (third requests))))
(check-equal? (causal-module-polynomial (certify-causal-modules local-history)) (padd z (pmul AX AY)))


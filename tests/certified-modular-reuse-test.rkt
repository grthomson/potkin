#lang racket/base
(require rackunit racket/list "../potkin/main.rkt" "../examples/certified-modular-reuse.rkt")

(define (status u name) (reuse-contract-status (hash-ref (reuse-update-contracts u) name)))
(define (prep f #:require [req '(behavior boundary replay profile)] #:policy [policy 'bidirectional])
  (prepare-reuse (reuse-fixture-source f) (reuse-fixture-frontier f) (reuse-fixture-model f)
    #:profile (reuse-fixture-profile f) #:history (reuse-fixture-history f) #:require req #:policy policy))

(test-case "dim2 correlated update is jointly equal but old live profile rejects new IDs"
  (define f (make-curried-reuse-fixture))
  (define p (prep f))
  (define u (apply-reuse-update p (reuse-fixture-replacements f)))
  (check-eq? (status u 'behavior) 'EQUAL)
  (check-eq? (status u 'boundary) 'SAFE)
  (check-eq? (status u 'replay) 'ELIGIBLE)
  (check-eq? (status u 'profile) 'INELIGIBLE)
  (check-false (reuse-update-accepted? u))
  (check-true (reuse-verification-valid? (verify-reuse-update p u)))
  (check-equal? (hash-ref (reuse-update-plan u) 'context-compilations) 0)
  (check-equal? (hash-ref (reuse-update-plan u) 'provider-admissions) 2)
  (check-equal? (hash-ref (reuse-update-plan u) 'cached-summaries) '(2))
  (check-equal? (hash-ref (reuse-update-plan u) 'replay-provider-body-reads) 0)
  (define behavioral (prep f #:require '(behavior)))
  (check-true (reuse-update-accepted? (apply-reuse-update behavioral (reuse-fixture-replacements f))))
  (define enlarged (apply-reuse-update p (reuse-fixture-replacements f) #:profile '(e d r e-new d-new)))
  (check-eq? (status enlarged 'profile) 'ELIGIBLE)
  (check-true (reuse-update-accepted? enlarged))
  ;; Profile eligibility is NOT equality of historical provenance expressions.
  (check-not-eq? (status enlarged 'fidelity) 'SAFE))

(test-case "two-argument strict curried family retains four providers and one scaffold block"
  (define f (make-curried-family-reuse-fixture 2))
  (define source (reuse-fixture-source f))
  (define protection (certify-structured-ck-protection source))
  (check-eq? (ck-protection-result-status protection) 'SAFE)
  (define evidence (ck-protection-result-evidence protection))
  (define certificate (ck-protection-evidence-certificate evidence))
  (check-eq? (ck-structured-certificate-family certificate) 'curried-application)
  (check-equal? (length (ck-structured-certificate-providers certificate)) 4)
  (check-equal? (length (remove-duplicates (vector->list (ck-protection-evidence-partition evidence)))) 5)
  (check-equal? (length (ck-structured-certificate-history certificate)) 3)
  (check-equal? (length (reuse-fixture-history f)) 3)
  (check-true (ck-closure-report-valid? (verify-structured-ck-certificate certificate)))
  (define p (prep f))
  (define u (apply-reuse-update p (reuse-fixture-replacements f)))
  (check-true (reuse-update-accepted? u))
  (check-equal? (hash-ref (reuse-update-plan u) 'replayed-events) 3)
  (check-true (reuse-verification-valid? (verify-reuse-update p u))))

(test-case "omitted compensation has independently checked basis counterinput"
  (define f (make-curried-reuse-fixture))
  (define p (prep f #:require '(behavior)))
  (define old (reuse-preparation-providers p))
  (define u (apply-reuse-update p (list (first old) (second (reuse-fixture-replacements f)) (third old))))
  (check-eq? (status u 'behavior) 'DIFFERENT)
  (check-false (reuse-update-accepted? u))
  (define witness (behavior-result-witness (reuse-contract-evidence (reuse-update-behavior u))))
  (check-true (semantic-counterinput-verified? witness))
  (check-not-equal? (semantic-counterinput-old-value witness) (semantic-counterinput-new-value witness))
  (check-true (reuse-verification-valid? (verify-reuse-update p u))))

(test-case "checked scaffold conversion replays around opaque unchanged providers"
  (define f (make-tensor-reuse-fixture))
  (define p (prep f))
  (define u (apply-reuse-update p (reuse-fixture-replacements f)))
  (check-true (reuse-update-accepted? u))
  (check-not-equal? (reuse-update-filled u) (reuse-update-replayed u))
  (check-equal? (hash-ref (reuse-update-plan u) 'provider-admissions) 0)
  (check-equal? (hash-ref (reuse-update-plan u) 'replayed-events) 1)
  (check-true (reuse-verification-valid? (verify-reuse-update p u)))
  (define c (reuse-contract-evidence (reuse-update-replay u)))
  (define step (car (opaque-replay-certificate-steps c)))
  (define corrupt-step
    (struct-copy opaque-replay-step step [after-holes (opaque-replay-step-before-holes step)]))
  (define corrupt (struct-copy opaque-replay-certificate c [steps (list corrupt-step)]))
  (check-false (reuse-verification-valid? (verify-opaque-replay corrupt))))

(test-case "m2 later dependency is forward safe and inverse unsafe with two-step evidence"
  (define f (make-tensor-reuse-fixture 2 #:dependent-position 2))
  (define pf (prep f #:policy 'forward))
  (define pb (prep f))
  (define uf (apply-reuse-update pf (reuse-fixture-replacements f)))
  (define ub (apply-reuse-update pb (reuse-fixture-replacements f)))
  (check-eq? (status uf 'boundary) 'SAFE)
  (check-eq? (status ub 'boundary) 'UNSAFE)
  (define c (reuse-contract-evidence (reuse-update-boundary ub)))
  (check-not-false (ck-boundary-certificate-crossing c))
  (check-true (reuse-verification-valid? (verify-reuse-update pb ub)))
  (check-false (hash-ref (reuse-update-plan ub) 'global-minimum-cost-claimed))
  (define first-position (make-tensor-reuse-fixture 2 #:dependent-position 1))
  (check-eq? (status (apply-reuse-update (prep first-position) (reuse-fixture-replacements first-position)) 'boundary) 'SAFE))

(test-case "new proof never reuses source-bound certificate"
  (define f (make-tensor-reuse-fixture))
  (define p (prep f))
  (define u (apply-reuse-update p (reuse-fixture-replacements f)))
  (define corrupt (struct-copy reuse-update u [boundary (reuse-preparation-boundary p)]))
  (check-false (reuse-verification-valid? (verify-reuse-update p corrupt)))
  (define corrupt-plan (struct-copy reuse-update u [accepted? #f]))
  (check-false (reuse-verification-valid? (verify-reuse-update p corrupt-plan)))
  (define wrong-counts (struct-copy reuse-update u
    [plan (hash-set (reuse-update-plan u) 'provider-admissions 99)]))
  (check-false (reuse-verification-valid? (verify-reuse-update p wrong-counts)))
  (define wrong-cache (struct-copy reuse-preparation p
    [compiled (compile-rational-context (reuse-fixture-model f) (reuse-fixture-source f))]))
  (define wrong-result (struct-copy reuse-update u [preparation wrong-cache]))
  (check-false (reuse-verification-valid? (verify-reuse-update wrong-cache wrong-result)))
  (define invalid-request (struct-copy reuse-preparation p [requested '(behavior forged-contract)]))
  (define invalid-request-result (struct-copy reuse-update u [preparation invalid-request]))
  (check-false (reuse-verification-valid? (verify-reuse-update invalid-request invalid-request-result))))

(test-case "statuses cannot cross contract namespaces to bypass independent checking"
  (define f (make-tensor-reuse-fixture))
  (define p (prep f))
  (define u (apply-reuse-update p (reuse-fixture-replacements f)))
  (define forged (reuse-contract 'EQUAL #f 'forged (hash)))
  (for ([corrupt (in-list
        (list (struct-copy reuse-update u [boundary forged])
              (struct-copy reuse-update u [replay (reuse-contract 'SAFE #f 'forged (hash))])
              (struct-copy reuse-update u [behavior (reuse-contract 'SAFE #f 'forged (hash))])
              (struct-copy reuse-update u [fidelity (reuse-contract 'ELIGIBLE #f 'forged (hash))])
              (struct-copy reuse-update u [material (reuse-contract 'SAFE #f 'forged (hash))])))])
    (check-false (reuse-verification-valid? (verify-reuse-update p corrupt)))))

(test-case "preparation and changed-provider admission budgets produce explicit UNKNOWN"
  (define f (make-curried-reuse-fixture))
  (define exhausted (make-semantic-budget #:max-nodes 0))
  (define preparation-result
    (prepare-reuse (reuse-fixture-source f) (reuse-fixture-frontier f) (reuse-fixture-model f)
      #:profile (reuse-fixture-profile f) #:semantic-budget exhausted))
  (check-true (reuse-contract? preparation-result))
  (check-eq? (reuse-contract-status preparation-result) 'UNKNOWN)
  (check-eq? (hash-ref (reuse-contract-details preparation-result) 'phase) 'context-compilation)
  (check-false (hash-ref (reuse-contract-details preparation-result) 'preparation-created?))
  (define p (prep f))
  (define update-result (apply-reuse-update p (reuse-fixture-replacements f) #:semantic-budget exhausted))
  (check-true (reuse-contract? update-result))
  (check-eq? (reuse-contract-status update-result) 'UNKNOWN)
  (check-eq? (hash-ref (reuse-contract-details update-result) 'phase) 'provider-admission)
  (check-false (hash-ref (reuse-contract-details update-result) 'accepted-update-created?)))

(test-case "same-interface compound refill can enable a new inverse crossing"
  (define f (make-tensor-reuse-fixture 2 #:dependent-position 1))
  (define p (prep f #:require '(behavior boundary)))
  (check-eq? (reuse-contract-status (reuse-preparation-boundary p)) 'SAFE)
  (define old-model (reuse-fixture-model f))
  (define old-K (rational-model-calculus old-model))
  (define (occ id left right)
    (make-concrete-occurrence id '() (singleton-hypersequent left (list right)) #:kind 'material))
  (define new-K (make-mixed-schema-calculus
    (append (mixed-schema-material-occurrences old-K)
            (list (occ 'alt-p1 '() 'a1) (occ 'alt-p2 '(d) 'a2)))))
  (define (g id) (validate-candidate new-K (raw-app id)))
  (define tr (mixed-apply new-K 'tensorR (list (g 'alt-p1) (g 'alt-p2))))
  (define tl (mixed-apply new-K 'tensorL (list (g 'r)) #:indices '(1 2)))
  (define new-bundle (mixed-apply new-K 'cut+ (list tr tl) #:indices '(1)))
  (define new-model (make-rational-model new-K (rational-model-atom-dimensions old-model)
    (hash-set (hash-set (rational-model-material-maps old-model) 'alt-p1 (make-qmatrix '((1))))
              'alt-p2 (make-qmatrix '((1)))) #:version '(extended-demo 1)))
  (define u (apply-reuse-update p (list new-bundle) #:model new-model
              #:profile '(p1 p2 r s alt-p1 alt-p2)))
  (check-eq? (status u 'behavior) 'EQUAL)
  (check-eq? (status u 'boundary) 'UNSAFE)
  (check-eq? (status u 'replay) 'UNKNOWN)
  (check-false (reuse-update-accepted? u))
  (check-true (reuse-verification-valid? (verify-reuse-update p u))))

(test-case "full fidelity evidence is bound to actual source/profile and replacement"
  (define f (make-curried-reuse-fixture))
  (define p (prep f #:require '(behavior fidelity)))
  (define u (apply-reuse-update p (reuse-fixture-replacements f) #:profile '(e d r e-new d-new)))
  (define o (reuse-preparation-observables p))
  (when (and o (eq? (ck-protected-observables-status o) 'SAFE))
    (define forged (struct-copy reuse-update u
      [fidelity (reuse-contract 'SAFE (list o o) 'forged-equal-pair (hash))] [accepted? #t]))
    (check-false (reuse-verification-valid? (verify-reuse-update p forged))))
  (define unrelated (make-tensor-reuse-fixture))
  (define unrelated-protection (prepare-ck-protection (reuse-fixture-source unrelated)))
  (define foreign-preparation (struct-copy reuse-preparation p [protection unrelated-protection]))
  (define foreign-result (struct-copy reuse-update u [preparation foreign-preparation]
                          [fidelity (reuse-contract 'SAFE (list o o) 'forged (hash))]))
  (define verification (verify-reuse-update foreign-preparation foreign-result))
  (check-false (reuse-verification-valid? verification))
  (check-eq? (reuse-verification-reason verification) 'unverified-original-protection))

(test-case "nested typed contexts preserve physical hole prefix, staged semantics and projected replay"
  (define n (nested-reuse-example))
  (check-equal? (hash-ref n 'hole-order) '((1 1 1) (1 2) (2 1)))
  (check-true (hash-ref n 'staged=direct))
  (check-true (hash-ref n 'replay=direct))
  (check-true (reuse-verification-valid? (hash-ref n 'verification))))

(test-case "repeated formulas retain exact coherent event routing"
  (define (occ id left right)
    (make-concrete-occurrence id '() (singleton-hypersequent left (list right)) #:kind 'material))
  (define K (make-mixed-schema-calculus (list (occ 'p '(g g) 'a) (occ 'q '(g) 'a) (occ 'r '(a a) 'c))))
  (define (g id) (validate-candidate K (raw-app id)))
  (define producer (mixed-apply K 'tensorR (list (g 'p) (g 'q))))
  (define consumer (mixed-apply K 'tensorL (list (g 'r)) #:indices '(1 2)))
  (define source (mixed-apply K 'cut+ (list producer consumer) #:indices '(1)))
  (define frontier (make-cut-witness source '((1 1) (1 2) (2 1))))
  (define-values (moves done? why) (enumerate-ck-schema-moves source #:policy 'forward))
  (check-true done?)
  (define event (car moves))
  (define projected (project-opaque-history source frontier (list event) #:policy 'forward))
  (check-eq? (reuse-contract-status projected) 'ELIGIBLE)
  (define cert (reuse-contract-evidence projected))
  (check-true (reuse-verification-valid? (verify-opaque-replay cert)))
  (define target (ck-schema-move-target event))
  (define actual-order (mixed-occurrence-order K (checked-node-occurrence target)))
  (define wrong-target
    (mixed-apply K 'cut+ (checked-node-children target)
      #:indices (mixed-occurrence-indices K (checked-node-occurrence target)) #:order (reverse actual-order)))
  (check-not-equal? target wrong-target)
  (define wrong-event (struct-copy ck-schema-move event [target wrong-target]))
  (define wrong-cert (struct-copy opaque-replay-certificate cert [history (list wrong-event)]))
  (check-false (reuse-verification-valid? (verify-opaque-replay wrong-cert)))
  (define foreign-K (make-mixed-schema-calculus (mixed-schema-material-occurrences K)))
  (define foreign-target (validate-candidate foreign-K (checked-term->raw target)))
  (check-equal? foreign-target target)
  (define foreign-event (struct-copy ck-schema-move event [target foreign-target]))
  (define foreign-cert (struct-copy opaque-replay-certificate cert [history (list foreign-event)]))
  (check-false (reuse-verification-valid? (verify-opaque-replay foreign-cert)))
  (check-eq? (reuse-contract-status (project-opaque-history source frontier (list foreign-event) #:policy 'forward))
            'INELIGIBLE))
